# 复制为 .env 后由应用启动时自动加载（src/env.js）。
# 已注入到进程的环境变量优先级高于本文件。

# 初始登录账号：仅在数据库中还没有账号时用于创建第一个账号（单账号，不开放注册）
# 创建后请在面板「设置 - 登录账号」中修改，此处配置不再生效
APP_USERNAME=admin
APP_PASSWORD=admin123

# 会话签名密钥：保持稳定即可，未设置时每次重启都会失效所有登录
SESSION_SECRET=please-change-to-a-random-string

# 服务监听端口与地址
PORT=3000
HOST=0.0.0.0

# 单个附件大小上限（MB）
MAX_UPLOAD_MB=100

# 回收站保留天数，超期自动彻底删除（默认 30）
TRASH_RETENTION_DAYS=30

# 一键更新的重启命令（可选）：设置后「更新」完成时会执行该命令重启服务
# 未设置时会依次尝试 pm2 / systemd / 自启后台进程
# 例如宝塔 Node 项目或 pm2 进程可设为：pm2 restart task-panel
# RESTART_COMMAND=

# Cloudflare R2 对象存储（可选）：全部填写后，上传附件时会出现“Cloudflare R2”选项
# 也推荐直接在应用内「设置」页填写，页面保存的值会覆盖这里的同名配置，且无需重启
# 文件通过 R2_PUBLIC_BASE_URL 公开访问，请在 R2 中开启公开访问或绑定自定义域名
# R2_ACCOUNT_ID=your_account_id
# R2_ACCESS_KEY_ID=your_access_key_id
# R2_SECRET_ACCESS_KEY=your_secret_access_key
# R2_BUCKET=task-board
# R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev
# 以下为可选项
# R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# R2_REGION=auto
# R2_PREFIX=attachments
# R2_FORCE_PATH_STYLE=0

# 数据目录（默认 ./data，包含 app.db 与 uploads/）
# DATA_DIR=/var/lib/task-board
