<?xml version="1.0" encoding="utf-8"?>
<!--
  自建服务常以明文 HTTP 暴露在局域网或自有域名下，因此允许明文流量。
  客户端在设置页会针对 http:// 地址给出安全风险提示。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
